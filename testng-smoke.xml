<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Eventhub Smoke Suite" parallel="classes" thread-count="3" verbose = "1">
    <listeners>
        <listener class-name="com.eventhub.listeners.TestListener"/>
        <listener class-name="com.eventhub.listeners.AnnotationTransformer"/>
    </listeners>
    <test name="Eventhub - Smoke">
        <groups>
            <run>
                <include name="Smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.eventhub.tests.*"/>
        </packages>
    </test>
</suite>