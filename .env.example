# Copy to .env and adjust. Every value is optional.
BASE_URL=https://eventhub.rahulshettyacademy.com

# Routes (verify with `npm run codegen`)
LOGIN_PATH=/login
REGISTER_PATH=/register
EVENTS_PATH=/events
BOOKINGS_PATH=/bookings

# Leave blank to auto-register one fresh user per worker through the UI
TEST_EMAIL=
TEST_PASSWORD=

# Execution
HEADED=false
WORKERS=
RETRIES=