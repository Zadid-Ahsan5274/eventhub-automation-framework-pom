<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EventHub Regression Suite" parallel="classes" thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.eventhub.listeners.TestListener"/>
        <listener class-name="com.eventhub.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="EventHub - Full Regression">
        <packages>
            <package name="com.eventhub.tests.*"/>
        </packages>
    </test>
</suite>