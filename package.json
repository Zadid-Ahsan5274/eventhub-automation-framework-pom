{
  "name": "eventhub-playwright-ts",
  "version": "1.0.0",
  "description": "EventHub UI test automation - Playwright + TypeScript + Allure",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "HEADED=true playwright test --project=chromium",
    "test:debug": "PWDEBUG=1 playwright test --project=chromium",
    "codegen": "playwright codegen https://eventhub.rahulshettyacademy.com/login",
    "typecheck": "tsc --noEmit",
    "browsers:install": "playwright install --with-deps",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report:html": "playwright show-report",
    "clean": "rm -rf allure-results allure-report playwright-report test-results .auth"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.6",
    "typescript": "^7.0.2"
  },
  "engines": { "node": ">=18" }
}